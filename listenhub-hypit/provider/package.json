{
  "name": "@listenhub/provider-hypit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "hypit": {
    "activation": "./dist/activation.js"
  },
  "exports": {
    ".": "./dist/provider.js",
    "./keying": "./dist/keying.js",
    "./transcript": "./dist/transcript.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "SOURCES.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "peerDependencies": {
    "@hypit/hypit": "0.2.1"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@hypit/hypit": "0.2.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "typescript": "5.9.3",
    "xo": "0.60.0",
    "tsx": "4.21.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "xo",
    "test": "npm run build && node --import ./test/register.js --test test/*.test.js"
  },
  "xo": {
    "space": 2,
    "prettier": true,
    "extensions": [
      "ts"
    ],
    "ignores": [
      "dist/**",
      "test/**"
    ],
    "rules": {
      "@typescript-eslint/naming-convention": "off"
    }
  }
}
