<?svml using="@hypit/markup@1"?>
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="performance" from="@hypit/performance@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="style" source="./styles.svs"/>
  <script id="story"><dance/></script>
  <asset:Video id="pet" src="./assets/pet.mp4"/>
  <asset:Audio id="music" src="./assets/music.wav"/>
  <time:Clock id="clock" frame-rate="30"/>
  <pipeline:Normalize id="pet-media" source={pet} video="primary-moving" audio="none" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="music-media" source={music} video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:SemanticTake id="dance" narrative={story} segment={story.segment.dance} media={pet-media.media}/>
  <time:Timeline id="program" clock={clock}><time:Take source={dance.take}/></time:Timeline>
  <space:Canvas id="canvas" width="720" height="1280"/>
  <space:Frame id="full" within={canvas} left="0%" top="0%" right="100%" bottom="100%"/>
  <performance:Style id="full-picture" frame={full} appearance={style.media.full}/>
  <performance:Track id="picture" timeline={program.timeline} canvas={canvas}><performance:Use style={full-picture}/></performance:Track>
  <audio:Track id="score" timeline={program.timeline}><audio:Item source={music-media.media} during="program" playback="once" gain="0.5" fade-out="6f"/></audio:Track>
  <film:Film id="main" canvas={canvas} timeline={program.timeline} appearance={style.film.main}><film:Track source={picture.visual}/><film:Track source={score.audio}/></film:Film>
  <render:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
