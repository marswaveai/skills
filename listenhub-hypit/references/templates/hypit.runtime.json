{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/listenhub",
  "credentials": { "platform": { "use": "@hypit/credential-store-platform" } },
  "endpoints": {
    "media.local": { "use": "@hypit/provider-media-local" },
    "hyperframes.local": { "use": "@hypit/provider-hyperframes-local", "config": { "workers": 2 } },
    "image-opencv.local": { "use": "@hypit/provider-image-opencv-local" },
    "listenhub.local": {
      "use": "@listenhub/provider-hypit",
      "config": {
        "baseUrl": "https://api.listenhub.ai/openapi",
        "apiKey": { "store": "platform", "key": "listenhub.api-key" }
      }
    }
  },
  "bindings": {
    "@hypit/whisperx@1#whisperx-alignment": "listenhub.local",
    "@hypit/background-removal@1#remove-background": "listenhub.local"
  }
}
