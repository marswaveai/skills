<?svml using="@hypit/markup@1"?>
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="performance" from="@hypit/performance@1"/>
  <import as="sound" from="@hypit/sound@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="style" source="./styles.svs"/>
  <script id="story"><action/></script>
  <asset:Video id="footage" src="./assets/footage.mp4"/>
  <time:Clock id="clock" frame-rate="30"/>
  <pipeline:Normalize id="footage-media" source={footage} video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <whisperx:SemanticTake id="action" narrative={story} segment={story.segment.action} media={footage-media.media}/>
  <time:Timeline id="program" clock={clock}><time:Take source={action.take}/></time:Timeline>
  <space:Canvas id="canvas" width="720" height="1280"/>
  <space:Frame id="full" within={canvas} left="0%" top="0%" right="100%" bottom="100%"/>
  <performance:Style id="full-picture" frame={full} appearance={style.media.full}/>
  <performance:Track id="picture" timeline={program.timeline} canvas={canvas}><performance:Use style={full-picture}/></performance:Track>
  <sound:Style id="original-style"/>
  <sound:Track id="original-sound" timeline={program.timeline}><sound:Use style={original-style}/></sound:Track>
  <film:Film id="main" canvas={canvas} timeline={program.timeline} appearance={style.film.main}><film:Track source={picture.visual}/><film:Track source={original-sound.audio}/></film:Film>
  <render:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
